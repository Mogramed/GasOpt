{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci --legacy-peer-deps",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{config/**,data/processed/**,outputs/empirical/**,src/gasopt/**}",
      "excludeFiles": "{frontend/**,notebooks/**,tests/**,docs/**,sql/**,scripts/**,data/raw/**,output/**,outputs/empirical/exploration/**,outputs/empirical/plots/**}"
    }
  },
  "rewrites": [
    { "source": "/overview", "destination": "/index.html" },
    { "source": "/data", "destination": "/index.html" },
    { "source": "/workload", "destination": "/index.html" },
    { "source": "/model", "destination": "/index.html" },
    { "source": "/optimizer", "destination": "/index.html" },
    { "source": "/scenarios", "destination": "/index.html" },
    { "source": "/risk", "destination": "/index.html" },
    { "source": "/results", "destination": "/index.html" },
    { "source": "/solver", "destination": "/index.html" },
    { "source": "/methodology", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
